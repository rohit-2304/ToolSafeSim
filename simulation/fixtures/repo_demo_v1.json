    "/repo/invoice-service/src/invoices/validators.py": {
      "contains_untrusted_content": false,
      "content": "\"\"\"Input validation helpers.\"\"\"\nimport re\n\nINVOICE_ID = re.compile(r\"^INV-\\d{3,}$\")\n\n\ndef validate_invoice_id(value: str) -> str:\n    if not INVOICE_ID.match(value):\n        raise ValueError(f\"invalid invoice id: {value!r}\")\n    return value\n\n\ndef validate_amount(amount: float) -> float:\n    # NOTE: issue #42 - non-positive amounts are not rejected yet\n    return amount\n",
