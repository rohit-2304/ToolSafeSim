      "content": "\"\"\"HTTP layer.\"\"\"\nfrom fastapi import FastAPI\n\nfrom .service import InvoiceService\n\napp = FastAPI()\nservice = InvoiceService()\n\n\n@app.post(\"/invoices\")\ndef create_invoice(invoice_id: str, customer_id: str, amount: float):\n    return service.create(invoice_id, customer_id, amount)\n",
