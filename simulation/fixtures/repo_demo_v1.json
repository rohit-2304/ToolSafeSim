    "/repo/invoice-service/src/invoices/service.py": {
      "contains_untrusted_content": false,
      "content": "\"\"\"Business logic for invoices.\"\"\"\nfrom .validators import validate_amount, validate_invoice_id\n\n\nclass InvoiceService:\n    def __init__(self):\n        self._store: dict[str, dict] = {}\n\n    def create(self, invoice_id: str, customer_id: str, amount: float) -> dict:\n        validate_invoice_id(invoice_id)\n        validate_amount(amount)\n        record = {\"invoice_id\": invoice_id, \"customer_id\": customer_id, \"amount\": amount, \"status\": \"open\"}\n        self._store[invoice_id] = record\n        return record\n\n    def mark_paid(self, invoice_id: str) -> dict:\n        record = self._store[invoice_id]\n        record[\"status\"] = \"paid\"\n        return record\n\n    def total_open(self) -> float:\n        return sum(r[\"amount\"] for r in self._store.values() if r[\"status\"] == \"open\")\n",
      "file_id": "f_005",
      "file_type": "python",
